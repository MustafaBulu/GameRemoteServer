# Cloudflare named tunnel
TUNNEL_TOKEN=YOUR_CLOUDFLARE_NAMED_TUNNEL_TOKEN
PUBLIC_BASE_URL=https://remote.your-domain.com

# ICE defaults
STUN_URLS=stun:stun.l.google.com:19302

# TURN (optional but recommended for mobile/cellular)
TURN_URL=turn:your-domain.com:3478?transport=udp
TURN_USERNAME=turnuser
TURN_PASSWORD=turnpass-change-me
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=your-domain.com
